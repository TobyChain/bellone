# 壹铃 Bellone — 全部可选，开箱即用（不配置也能跑）
# 复制为 .env 后按需修改

# 服务端口，默认 3210
# PORT=3210

# 数据目录，默认 ./data
# BELLONE_DATA_DIR=./data

# ---- AI 助手（可选）。不配置时提醒/打卡/周报照常工作，仅 AI 对话不可用 ----
# OpenAI 兼容接口，如 DashScope / OpenAI / Ollama
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=sk-xxx
# LLM_MODEL=qwen-plus
